{"name": "logical_and", "kind": "a", "args": ["bool"], "nullable": true}
{"name": "logical_or", "kind": "a", "args": ["bool"], "nullable": true}
{"name": "max", "kind": "a", "args": ["T"], "returns": "$1", "nullable": true}
{"name": "min", "kind": "a", "args": ["T"], "returns": "$1", "nullable": true}
{"name": "string_agg", "kind": "a", "args": ["string"], "nullable": true}
