# unnest stands for UNNEST(array) in FROM and IN, which sqlc reads as a
# call; its element can be NULL.
{"name": "unnest", "args": ["AT"], "returns": "anyelement", "expr": "(SELECT e FROM UNNEST($1) AS e LIMIT 1)", "nullable": true}
