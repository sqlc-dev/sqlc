# Candidate signatures of Spanner's GoogleSQL functions. Spanner keeps no
# catalog of its functions, so this file lists the calls to try; goldeneye
# compiles each one in PLAN mode against the probe table in library.go,
# keeps the ones Spanner accepts and writes the result type Spanner reports.
#
# An argument is a type, a type=literal for an argument Spanner wants as a
# literal, T for a polymorphic value or AT for an array of one. A
# polymorphic signature is tried with INT64 and STRING, and its returns
# ($1 for the first argument's type, array($1), anyelement for an AT's
# element) must match what Spanner reports for both. nullable and
# never_null say what Spanner cannot: whether the result can be NULL when
# the arguments are not, or is never NULL when they are.
# Aggregates: NULL over no rows, except the counts.
{"name": "count", "kind": "a", "args": ["T"], "returns": "int64", "never_null": true}
{"name": "countif", "kind": "a", "args": ["bool"], "never_null": true}
{"name": "any_value", "kind": "a", "args": ["T"], "returns": "$1", "nullable": true}
{"name": "array_agg", "kind": "a", "args": ["T"], "returns": "array($1)", "nullable": true}
{"name": "array_concat_agg", "kind": "a", "args": ["AT"], "returns": "$1", "nullable": true}
{"name": "avg", "kind": "a", "args": ["int64"], "nullable": true}
{"name": "avg", "kind": "a", "args": ["float64"], "nullable": true}
{"name": "avg", "kind": "a", "args": ["float32"], "nullable": true}
{"name": "avg", "kind": "a", "args": ["numeric"], "nullable": true}
{"name": "avg", "kind": "a", "args": ["interval"], "nullable": true}
{"name": "bit_and", "kind": "a", "args": ["int64"], "nullable": true}
{"name": "bit_or", "kind": "a", "args": ["int64"], "nullable": true}
