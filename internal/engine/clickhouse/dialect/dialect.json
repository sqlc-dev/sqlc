{
  "dialect": "clickhouse",
  "default_schema": "default",
  "const": {
    "integer": "Int64",
    "float": "Float64",
    "string": "String",
    "bool": "Bool"
  },
  "bool": "UInt8",
  "limit": "UInt64",
  "untyped": "Nothing",
  "propagate_nullable": true,
  "qualify_duplicate_columns": true,
  "comparison": ["=", "==", "<>", "!=", "<", "<=", ">", ">="],
  "comparison_categories": "NBSDU",
  "arithmetic": ["+", "-", "*", "/", "%"],
  "arithmetic_categories": "N",
  "rewrites": [
    {
      "from": "Decimal32($1)",
      "to": "Decimal(9, $1)"
    },
    {
      "from": "Decimal64($1)",
      "to": "Decimal(18, $1)"
    },
    {
      "from": "Decimal128($1)",
      "to": "Decimal(38, $1)"
    },
    {
      "from": "Decimal256($1)",
      "to": "Decimal(76, $1)"
    }
  ],
  "ident_args": {
    "AggregateFunction": [1],
    "SimpleAggregateFunction": [1]
  }
}
