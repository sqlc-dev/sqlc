{
  "dialect": "duckdb",
  "default_schema": "main",
  "const": {
    "integer": "integer",
    "float": "double",
    "string": "varchar",
    "bool": "boolean"
  },
  "bool": "boolean",
  "comparison": ["=", "==", "<>", "!=", "<", "<=", ">", ">=", "IS DISTINCT FROM", "IS NOT DISTINCT FROM"],
  "comparison_categories": "BNSDU",
  "arithmetic": ["+", "-", "*", "/", "//", "%", "**", "^"],
  "arithmetic_categories": "N",
  "cast_categories": "NSD",
  "rewrites": [
    {
      "from": "varchar($1)",
      "to": "varchar"
    },
    {
      "from": "decimal",
      "to": "decimal(18, 3)"
    }
  ]
}
