{
  "dialect": "mssql",
  "default_schema": "dbo",
  "const": {
    "integer": "int",
    "float": "float",
    "string": "varchar",
    "bool": "bit"
  },
  "bool": "bit",
  "set_operations": {
    "strategy": "mssql",
    "precedence": [
      "sql_variant", "xml", "datetimeoffset", "datetime2", "datetime",
      "smalldatetime", "date", "time", "float", "real", "decimal", "money",
      "smallmoney", "bigint", "int", "smallint", "tinyint", "bit", "ntext",
      "text", "image", "rowversion", "uniqueidentifier", "nvarchar", "nchar",
      "varchar", "char", "varbinary", "binary"
    ],
    "varying": {"char": "varchar", "nchar": "nvarchar", "binary": "varbinary"},
    "decimal": "decimal",
    "decimal_max_precision": 38,
    "as_decimal": {
      "bit": [1, 0],
      "tinyint": [3, 0],
      "smallint": [5, 0],
      "int": [10, 0],
      "bigint": [19, 0],
      "money": [19, 4],
      "smallmoney": [10, 4]
    }
  },
  "comparison": ["=", "<>", "!=", "<", "<=", ">", ">="],
  "comparison_categories": "NBSD",
  "arithmetic": ["+", "-", "*", "/", "%"],
  "arithmetic_categories": "N",
  "cast_categories": "NSD",
  "idents": ["max"],
  "rewrites": [
    {
      "from": "sysname",
      "to": "nvarchar(128)"
    },
    {
      "from": "float($1)",
      "to": "real",
      "where": "$1 <= 24"
    },
    {
      "from": "float($1)",
      "to": "float"
    },
    {
      "from": "char",
      "to": "char(1)"
    },
    {
      "from": "varchar",
      "to": "varchar(1)"
    },
    {
      "from": "nchar",
      "to": "nchar(1)"
    },
    {
      "from": "nvarchar",
      "to": "nvarchar(1)"
    },
    {
      "from": "binary",
      "to": "binary(1)"
    },
    {
      "from": "varbinary",
      "to": "varbinary(1)"
    },
    {
      "from": "decimal",
      "to": "decimal(18, 0)"
    },
    {
      "from": "decimal($1)",
      "to": "decimal($1, 0)"
    },
    {
      "from": "numeric",
      "to": "numeric(18, 0)"
    },
    {
      "from": "numeric($1)",
      "to": "numeric($1, 0)"
    },
    {
      "from": "datetime2",
      "to": "datetime2(7)"
    },
    {
      "from": "time",
      "to": "time(7)"
    },
    {
      "from": "datetimeoffset",
      "to": "datetimeoffset(7)"
    }
  ]
}
